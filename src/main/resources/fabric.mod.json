{
  "schemaVersion": 1,
  "id": "skyblockmulti",
  "version": "${version}",
  "name": "Skyblock Multi",
  "description": "Configurable multiplayer Skyblock for Minecraft 26.3 with island allocation, difficulty selection, progression, custom recipes and optional Mod Menu support.",
  "authors": [
    "Treecs"
  ],
  "license": "MIT",
  "environment": "*",
  "icon": "assets/skyblockmulti/icon.png",
  "entrypoints": {
    "main": [
      "cl.treecs.skyblockmulti.SkyblockMultiMod",
      "cl.treecs.skyblockmulti.SkyblockDebugOverlay",
      "cl.treecs.skyblockmulti.region.LogicalRegionService",
      "cl.treecs.skyblockmulti.NexusFoundation",
      "cl.treecs.skyblockmulti.VersionJoinMessage",
      "cl.treecs.skyblockmulti.RequiredClientMod",
      "cl.treecs.skyblockmulti.PlayerReconnectHandler"
    ],
    "client": [
      "cl.treecs.skyblockmulti.client.RequiredClientModClient"
    ],
    "modmenu": [
      "cl.treecs.skyblockmulti.client.SkyblockMultiModMenu"
    ]
  },
  "mixins": [
    "skyblockmulti.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "26.3",
    "fabric-api": "*",
    "cloth-config": ">=26.3.159"
  },
  "suggests": {
    "modmenu": "*",
    "nexus_parties": ">=0.1.0-alpha.7",
    "openpartiesandclaims": "*",
    "jei": "*"
  },
  "custom": {
    "modmenu": {
      "update_checker": false
    }
  }
}
